#pragma mark - Discovery session

@interface OrbitDiscoverySession : AVCaptureDeviceDiscoverySession
@property (nonatomic, copy) NSArray<AVCaptureDevice *> *orbitDevices;
@end
@implementation OrbitDiscoverySession
- (instancetype)init { return self; }
- (NSArray<AVCaptureDevice *> *)devices { return _orbitDevices; }
- (NSArray<NSSet<AVCaptureDevice *> *> *)supportedMultiCamDeviceSets { return @[]; }
@end

static NSArray<OrbitCaptureDevice *> *OrbitDevicesForPosition(AVCaptureDevicePosition position) {
  if (position == AVCaptureDevicePositionFront) return @[ [OrbitCaptureDevice frontDevice] ];
  if (position == AVCaptureDevicePositionBack) return @[ [OrbitCaptureDevice backDevice] ];
  return [OrbitCaptureDevice allDevices];
}

static BOOL OrbitIsVideoMediaType(NSString *mediaType) {
  return mediaType == nil || [mediaType isEqualToString:AVMediaTypeVideo];
}

// AVCaptureDevice class methods
static NSArray *OrbitDevice_devices(id self, SEL _cmd) {
  NSArray *original = @[];
  IMP imp = OrbitOriginalIMP([AVCaptureDevice class], _cmd, YES);
  if (imp) original = ((NSArray * (*)(id, SEL))imp)(self, _cmd) ?: @[];
  return [[OrbitCaptureDevice allDevices] arrayByAddingObjectsFromArray:original];
}
static NSArray *OrbitDevice_devicesWithMediaType(id self, SEL _cmd, NSString *mediaType) {
  if (OrbitIsVideoMediaType(mediaType)) return [OrbitCaptureDevice allDevices];
  IMP imp = OrbitOriginalIMP([AVCaptureDevice class], _cmd, YES);
  return imp ? ((NSArray * (*)(id, SEL, id))imp)(self, _cmd, mediaType) : @[];
}
static id OrbitDevice_defaultDeviceWithMediaType(id self, SEL _cmd, NSString *mediaType) {
  if (OrbitIsVideoMediaType(mediaType)) return [OrbitCaptureDevice backDevice];
  IMP imp = OrbitOriginalIMP([AVCaptureDevice class], _cmd, YES);
  return imp ? ((id (*)(id, SEL, id))imp)(self, _cmd, mediaType) : nil;
}
static id OrbitDevice_defaultDeviceWithDeviceType(id self, SEL _cmd, NSString *type, NSString *mediaType,
                                                  AVCaptureDevicePosition position) {
  if (OrbitIsVideoMediaType(mediaType)) {
    if ([type isEqualToString:@"AVCaptureDeviceTypeExternal"] ||
        [type isEqualToString:@"AVCaptureDeviceTypeContinuityCamera"]) {
      return nil;
    }
    return OrbitDevicesForPosition(position).firstObject;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureDevice class], _cmd, YES);
  return imp ? ((id (*)(id, SEL, id, id, AVCaptureDevicePosition))imp)(self, _cmd, type, mediaType, position) : nil;
}
static NSArray *OrbitDevice_devicesWithDeviceType(id self, SEL _cmd, NSString *type, NSString *mediaType,
                                                  AVCaptureDevicePosition position) {
  if (OrbitIsVideoMediaType(mediaType)) return OrbitDevicesForPosition(position);
  return @[];
}
static id OrbitDevice_deviceWithUniqueID(id self, SEL _cmd, NSString *uniqueID) {
  for (OrbitCaptureDevice *device in [OrbitCaptureDevice allDevices]) {
    if ([device.uniqueID isEqualToString:uniqueID]) return device;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureDevice class], _cmd, YES);
  return imp ? ((id (*)(id, SEL, id))imp)(self, _cmd, uniqueID) : nil;
}
static AVAuthorizationStatus OrbitDevice_authorizationStatus(id self, SEL _cmd, NSString *mediaType) {
  if (OrbitIsVideoMediaType(mediaType)) return AVAuthorizationStatusAuthorized;
  IMP imp = OrbitOriginalIMP([AVCaptureDevice class], _cmd, YES);
  return imp ? ((AVAuthorizationStatus (*)(id, SEL, id))imp)(self, _cmd, mediaType) : AVAuthorizationStatusAuthorized;
}
static void OrbitDevice_requestAccess(id self, SEL _cmd, NSString *mediaType, void (^handler)(BOOL)) {
  if (OrbitIsVideoMediaType(mediaType)) {
    if (handler) dispatch_async(dispatch_get_main_queue(), ^{ handler(YES); });
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureDevice class], _cmd, YES);
  if (imp) ((void (*)(id, SEL, id, id))imp)(self, _cmd, mediaType, handler);
  else if (handler) handler(YES);
}
static id OrbitDevice_userPreferredCamera(id self, SEL _cmd) { return [OrbitCaptureDevice backDevice]; }
static void OrbitDevice_setUserPreferredCamera(id self, SEL _cmd, id device) {}
static id OrbitDevice_systemPreferredCamera(id self, SEL _cmd) { return [OrbitCaptureDevice backDevice]; }
static id OrbitDiscovery_sessionWithDeviceTypes(id self, SEL _cmd, NSArray *types, NSString *mediaType,
                                                AVCaptureDevicePosition position) {
  OrbitDiscoverySession *session = [OrbitDiscoverySession alloc];
  BOOL wantsCamera = NO;
  for (NSString *type in types) {
    if (![type isEqualToString:@"AVCaptureDeviceTypeExternal"] &&
        ![type isEqualToString:@"AVCaptureDeviceTypeContinuityCamera"] &&
        ![type isEqualToString:AVCaptureDeviceTypeBuiltInMicrophone]) {
      wantsCamera = YES;
    }
  }
  session.orbitDevices = wantsCamera && OrbitIsVideoMediaType(mediaType) ? OrbitDevicesForPosition(position) : @[];
  return session;
}
static BOOL OrbitMultiCam_isSupported(id self, SEL _cmd) { return NO; }

#pragma mark - Input and ports

@class OrbitCaptureInput;

@interface OrbitInputPort : AVCaptureInputPort
@property (nonatomic, weak) OrbitCaptureInput *orbitInput;
@property (nonatomic) BOOL orbitEnabled;
@end

@interface OrbitCaptureInput : AVCaptureDeviceInput
@property (nonatomic, strong) OrbitCaptureDevice *orbitDevice;
@property (nonatomic, strong) OrbitInputPort *orbitPort;
@end

@implementation OrbitInputPort {
  CMVideoFormatDescriptionRef _formatDescription;
}
- (instancetype)init { return self; }
- (AVCaptureInput *)input { return _orbitInput; }
- (AVMediaType)mediaType { return AVMediaTypeVideo; }
- (CMFormatDescriptionRef)formatDescription {
  if (!_formatDescription) {
    CMVideoFormatDescriptionCreate(kCFAllocatorDefault, kCVPixelFormatType_32BGRA, 1920, 1080, NULL, &_formatDescription);
  }
  return _formatDescription;
}
- (BOOL)isEnabled { return _orbitEnabled; }
- (void)setEnabled:(BOOL)enabled { _orbitEnabled = enabled; }
- (CMClockRef)clock { return CMClockGetHostTimeClock(); }
- (AVCaptureDeviceType)sourceDeviceType { return AVCaptureDeviceTypeBuiltInWideAngleCamera; }
- (AVCaptureDevicePosition)sourceDevicePosition { return _orbitInput.orbitDevice.orbitPosition; }
- (NSString *)description { return @"<OrbitInputPort video>"; }
@end

@implementation OrbitCaptureInput
+ (instancetype)inputWithDevice:(OrbitCaptureDevice *)device {
  OrbitCaptureInput *input = [self alloc];
  input.orbitDevice = device;
  OrbitInputPort *port = [OrbitInputPort alloc];
  port.orbitInput = input;
  port.orbitEnabled = YES;
  input.orbitPort = port;
  return input;
}
- (instancetype)init { return self; }
- (AVCaptureDevice *)device { return _orbitDevice; }
- (NSArray<AVCaptureInputPort *> *)ports { return @[ _orbitPort ]; }
- (NSArray<AVCaptureInputPort *> *)portsWithMediaType:(AVMediaType)mediaType sourceDeviceType:(AVCaptureDeviceType)type sourceDevicePosition:(AVCaptureDevicePosition)position {
  return OrbitIsVideoMediaType(mediaType) ? @[ _orbitPort ] : @[];
}
- (BOOL)unifiedAutoExposureDefaultsEnabled { return NO; }
- (void)setUnifiedAutoExposureDefaultsEnabled:(BOOL)e {}
- (CMTime)videoMinFrameDurationOverride { return kCMTimeInvalid; }
- (void)setVideoMinFrameDurationOverride:(CMTime)t {}
- (BOOL)isMultichannelAudioModeSupported:(AVCaptureMultichannelAudioMode)mode { return mode == AVCaptureMultichannelAudioModeNone; }
- (NSString *)description { return [NSString stringWithFormat:@"<OrbitCaptureInput %@>", _orbitDevice]; }
@end

static OrbitCaptureInput *OrbitInputIfOurs(id input) {
  return [input isKindOfClass:[OrbitCaptureInput class]] ? input : nil;
}

static id OrbitDeviceInput_deviceInputWithDevice(id self, SEL _cmd, AVCaptureDevice *device, NSError **error) {
  if ([device isKindOfClass:[OrbitCaptureDevice class]]) return [OrbitCaptureInput inputWithDevice:(OrbitCaptureDevice *)device];
  IMP imp = OrbitOriginalIMP([AVCaptureDeviceInput class], _cmd, YES);
  return imp ? ((id (*)(id, SEL, id, NSError **))imp)(self, _cmd, device, error) : nil;
}
static id OrbitDeviceInput_initWithDevice(id self, SEL _cmd, AVCaptureDevice *device, NSError **error) {
  if ([device isKindOfClass:[OrbitCaptureDevice class]]) return [OrbitCaptureInput inputWithDevice:(OrbitCaptureDevice *)device];
  IMP imp = OrbitOriginalIMP([AVCaptureDeviceInput class], _cmd, NO);
  return imp ? ((id (*)(id, SEL, id, NSError **))imp)(self, _cmd, device, error) : nil;
}

#pragma mark - Connection

@interface OrbitConnection : AVCaptureConnection
@property (nonatomic, strong) NSArray<AVCaptureInputPort *> *orbitPorts;
@property (nonatomic, weak) AVCaptureOutput *orbitOutput;
@property (nonatomic, weak) AVCaptureVideoPreviewLayer *orbitPreviewLayer;
@property (nonatomic) BOOL orbitEnabled;
@property (nonatomic) CGFloat orbitRotationAngle;
@property (nonatomic) BOOL orbitMirrored;
@property (nonatomic) BOOL orbitAutoMirror;
@property (nonatomic) AVCaptureVideoStabilizationMode orbitStabilization;
@property (nonatomic) CGFloat orbitScaleAndCrop;
+ (instancetype)connectionWithPorts:(NSArray<AVCaptureInputPort *> *)ports output:(AVCaptureOutput *)output;
+ (instancetype)connectionWithPorts:(NSArray<AVCaptureInputPort *> *)ports previewLayer:(AVCaptureVideoPreviewLayer *)layer;
- (AVCaptureDevicePosition)orbitPosition;
@end

@implementation OrbitConnection
+ (instancetype)connectionWithPorts:(NSArray<AVCaptureInputPort *> *)ports output:(AVCaptureOutput *)output {
  OrbitConnection *c = [self alloc];
  c.orbitPorts = ports;
  c.orbitOutput = output;
  c.orbitEnabled = YES;
  c.orbitRotationAngle = kOrbitDefaultRotationAngle;
  c.orbitScaleAndCrop = 1;
  return c;
}
+ (instancetype)connectionWithPorts:(NSArray<AVCaptureInputPort *> *)ports previewLayer:(AVCaptureVideoPreviewLayer *)layer {
  OrbitConnection *c = [self connectionWithPorts:ports output:nil];
  c.orbitPreviewLayer = layer;
  // Like AVFoundation: a preview of the front camera mirrors by default.
  c.orbitAutoMirror = YES;
  c.orbitMirrored = [c orbitPosition] == AVCaptureDevicePositionFront;
  return c;
}
- (instancetype)init { return self; }
- (AVCaptureDevicePosition)orbitPosition {
  OrbitInputPort *port = (OrbitInputPort *)_orbitPorts.firstObject;
  return [port isKindOfClass:[OrbitInputPort class]] ? port.orbitInput.orbitDevice.orbitPosition : AVCaptureDevicePositionBack;
}
- (NSArray<AVCaptureInputPort *> *)inputPorts { return _orbitPorts; }
- (AVCaptureOutput *)output { return _orbitOutput; }
- (AVCaptureVideoPreviewLayer *)videoPreviewLayer { return _orbitPreviewLayer; }
- (BOOL)isEnabled { return _orbitEnabled; }
- (void)setEnabled:(BOOL)e { _orbitEnabled = e; }
- (BOOL)isActive { return YES; }
- (NSArray<AVCaptureAudioChannel *> *)audioChannels { return @[]; }
- (BOOL)isVideoMirroringSupported { return YES; }
- (BOOL)isVideoMirrored { return _orbitMirrored; }
- (void)setVideoMirrored:(BOOL)m { _orbitMirrored = m; }
- (BOOL)automaticallyAdjustsVideoMirroring { return _orbitAutoMirror; }
- (void)setAutomaticallyAdjustsVideoMirroring:(BOOL)a { _orbitAutoMirror = a; }
- (BOOL)isVideoOrientationSupported { return YES; }
- (AVCaptureVideoOrientation)videoOrientation {
  switch ((int)lround(_orbitRotationAngle) % 360) {
    case 0: return AVCaptureVideoOrientationLandscapeRight;
    case 180: return AVCaptureVideoOrientationLandscapeLeft;
    case 270: return AVCaptureVideoOrientationPortraitUpsideDown;
    default: return AVCaptureVideoOrientationPortrait;
  }
}
- (void)setVideoOrientation:(AVCaptureVideoOrientation)o {
  switch (o) {
    case AVCaptureVideoOrientationLandscapeRight: _orbitRotationAngle = 0; break;
    case AVCaptureVideoOrientationLandscapeLeft: _orbitRotationAngle = 180; break;
    case AVCaptureVideoOrientationPortraitUpsideDown: _orbitRotationAngle = 270; break;
    default: _orbitRotationAngle = 90; break;
  }
}
- (BOOL)isVideoRotationAngleSupported:(CGFloat)angle { return fmod(angle, 90) == 0; }
- (CGFloat)videoRotationAngle { return _orbitRotationAngle; }
- (void)setVideoRotationAngle:(CGFloat)a { _orbitRotationAngle = fmod(fmod(a, 360) + 360, 360); }
- (BOOL)isVideoFieldModeSupported { return NO; }
- (BOOL)isVideoMinFrameDurationSupported { return YES; }
- (CMTime)videoMinFrameDuration { return CMTimeMake(1, kOrbitFrameRate); }
- (void)setVideoMinFrameDuration:(CMTime)t {}
- (BOOL)isVideoMaxFrameDurationSupported { return YES; }
- (CMTime)videoMaxFrameDuration { return CMTimeMake(1, kOrbitFrameRate); }
- (void)setVideoMaxFrameDuration:(CMTime)t {}
- (CGFloat)videoMaxScaleAndCropFactor { return 4; }
- (CGFloat)videoScaleAndCropFactor { return _orbitScaleAndCrop; }
- (void)setVideoScaleAndCropFactor:(CGFloat)f { _orbitScaleAndCrop = f; }
- (BOOL)isVideoStabilizationSupported { return NO; }
- (BOOL)isVideoStabilizationEnabled { return NO; }
- (AVCaptureVideoStabilizationMode)preferredVideoStabilizationMode { return _orbitStabilization; }
- (void)setPreferredVideoStabilizationMode:(AVCaptureVideoStabilizationMode)m { _orbitStabilization = m; }
- (AVCaptureVideoStabilizationMode)activeVideoStabilizationMode { return AVCaptureVideoStabilizationModeOff; }
- (BOOL)isCameraIntrinsicMatrixDeliverySupported { return NO; }
- (BOOL)isCameraIntrinsicMatrixDeliveryEnabled { return NO; }
- (void)setCameraIntrinsicMatrixDeliveryEnabled:(BOOL)e {}
- (NSString *)description {
  return [NSString stringWithFormat:@"<OrbitConnection angle=%.0f mirrored=%d>", _orbitRotationAngle, _orbitMirrored];
}
@end

#pragma mark - Session state

@interface OrbitSessionState : NSObject
@property (nonatomic, strong) NSMutableArray<OrbitCaptureInput *> *inputs;
@property (nonatomic, strong) NSMutableArray<AVCaptureOutput *> *outputs;
@property (nonatomic, strong) NSMutableArray<OrbitConnection *> *connections;
@property (nonatomic, strong) NSHashTable<AVCaptureVideoPreviewLayer *> *previewLayers;
@property (nonatomic, copy) NSString *preset;
@property (nonatomic) BOOL running;
@property (nonatomic) BOOL interrupted;
@end
@implementation OrbitSessionState
- (instancetype)init {
  if ((self = [super init])) {
    _inputs = [NSMutableArray new];
    _outputs = [NSMutableArray new];
    _connections = [NSMutableArray new];
    _previewLayers = [NSHashTable weakObjectsHashTable];
    _preset = AVCaptureSessionPresetHigh;
  }
  return self;
}
- (OrbitCaptureInput *)videoInput { return _inputs.firstObject; }
- (OrbitConnection *)connectionForOutput:(AVCaptureOutput *)output {
  for (OrbitConnection *c in _connections) if (c.orbitOutput == output) return c;
  return nil;
}
- (OrbitConnection *)connectionForPreviewLayer:(AVCaptureVideoPreviewLayer *)layer {
  for (OrbitConnection *c in _connections) if (c.orbitPreviewLayer == layer) return c;
  return nil;
}
@end

// All sessions that have state, so the frame timer can walk them.
static NSHashTable<AVCaptureSession *> *sSessions;
static NSLock *sSessionsLock;

static OrbitSessionState *OrbitStateForSession(AVCaptureSession *session, BOOL create) {
  OrbitSessionState *state = objc_getAssociatedObject(session, kOrbitSessionStateKey);
  if (!state && create) {
    state = [OrbitSessionState new];
    objc_setAssociatedObject(session, kOrbitSessionStateKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [sSessionsLock lock];
    [sSessions addObject:session];
    [sSessionsLock unlock];
  }
  return state;
}

static BOOL OrbitOutputWantsVideo(AVCaptureOutput *output) {
  return [output isKindOfClass:[AVCaptureVideoDataOutput class]] ||
         [output isKindOfClass:[AVCapturePhotoOutput class]] ||
         [output isKindOfClass:[AVCaptureMetadataOutput class]] ||
         [output isKindOfClass:[AVCaptureMovieFileOutput class]] ||
         [output isKindOfClass:NSClassFromString(@"AVCaptureStillImageOutput")];
}

// Creates the connections of the session's video input to its outputs and preview layers,
// as AVFoundation does when an input or output is added with connections.
static void OrbitConnectIfNeeded(AVCaptureSession *session, OrbitSessionState *state) {
  OrbitCaptureInput *input = state.videoInput;
  if (!input) return;
  for (AVCaptureOutput *output in state.outputs) {
    if (OrbitOutputWantsVideo(output) && ![state connectionForOutput:output]) {
      [state.connections addObject:[OrbitConnection connectionWithPorts:input.ports output:output]];
    }
  }
  for (AVCaptureVideoPreviewLayer *layer in state.previewLayers) {
    if (![state connectionForPreviewLayer:layer]) {
      [state.connections addObject:[OrbitConnection connectionWithPorts:input.ports previewLayer:layer]];
    }
  }
}

static void OrbitDisconnectInput(OrbitSessionState *state, OrbitCaptureInput *input) {
  NSMutableArray *remaining = [NSMutableArray new];
  for (OrbitConnection *c in state.connections) {
    if (c.orbitPorts.firstObject != input.orbitPort) [remaining addObject:c];
  }
  state.connections = remaining;
}

#define ORIGINAL(cls, ret, ...) ((ret (*)(id, SEL, ##__VA_ARGS__))OrbitOriginalIMP([cls class], _cmd, NO))
#define CALL_ORIGINAL_IF_PRESENT(cls, ret, dflt, ...)                          \
  do {                                                                          \
    IMP _imp = OrbitOriginalIMP([cls class], _cmd, NO);                        \
    if (_imp) return ((ret (*)(id, SEL, ##__VA_ARGS__))_imp)(self, _cmd, ##__VA_ARGS__); \
    return dflt;                                                                \
  } while (0)

// AVCaptureSession
static BOOL OrbitSession_canAddInput(AVCaptureSession *self, SEL _cmd, AVCaptureInput *input) {
  if (OrbitInputIfOurs(input)) return OrbitStateForSession(self, YES).videoInput == nil;
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  return imp ? ((BOOL (*)(id, SEL, id))imp)(self, _cmd, input) : NO;
}
static void OrbitSession_addInput(AVCaptureSession *self, SEL _cmd, AVCaptureInput *input) {
  OrbitCaptureInput *ours = OrbitInputIfOurs(input);
  if (ours) {
    OrbitSessionState *state = OrbitStateForSession(self, YES);
    if (![state.inputs containsObject:ours]) [state.inputs addObject:ours];
    OrbitConnectIfNeeded(self, state);
    ORBIT_LOG(@"Session %p: added input %@", self, ours);
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, input);
}
static void OrbitSession_addInputWithNoConnections(AVCaptureSession *self, SEL _cmd, AVCaptureInput *input) {
  OrbitCaptureInput *ours = OrbitInputIfOurs(input);
  if (ours) {
    OrbitSessionState *state = OrbitStateForSession(self, YES);
    if (![state.inputs containsObject:ours]) [state.inputs addObject:ours];
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, input);
}
static void OrbitSession_removeInput(AVCaptureSession *self, SEL _cmd, AVCaptureInput *input) {
  OrbitCaptureInput *ours = OrbitInputIfOurs(input);
  if (ours) {
    OrbitSessionState *state = OrbitStateForSession(self, NO);
    [state.inputs removeObject:ours];
    OrbitDisconnectInput(state, ours);
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, input);
}
static NSArray *OrbitSession_inputs(AVCaptureSession *self, SEL _cmd) {
  NSArray *original = @[];
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) original = ((NSArray * (*)(id, SEL))imp)(self, _cmd) ?: @[];
  OrbitSessionState *state = OrbitStateForSession(self, NO);
  return state ? [state.inputs arrayByAddingObjectsFromArray:original] : original;
}
static BOOL OrbitSession_canAddOutput(AVCaptureSession *self, SEL _cmd, AVCaptureOutput *output) {
  if (OrbitOutputWantsVideo(output)) return ![OrbitStateForSession(self, YES).outputs containsObject:output];
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  return imp ? ((BOOL (*)(id, SEL, id))imp)(self, _cmd, output) : NO;
}
static void OrbitSession_addOutput(AVCaptureSession *self, SEL _cmd, AVCaptureOutput *output) {
  if (OrbitOutputWantsVideo(output)) {
    OrbitSessionState *state = OrbitStateForSession(self, YES);
    if (![state.outputs containsObject:output]) [state.outputs addObject:output];
    OrbitConnectIfNeeded(self, state);
    ORBIT_LOG(@"Session %p: added output %@", self, output);
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, output);
}
static void OrbitSession_addOutputWithNoConnections(AVCaptureSession *self, SEL _cmd, AVCaptureOutput *output) {
  if (OrbitOutputWantsVideo(output)) {
    OrbitSessionState *state = OrbitStateForSession(self, YES);
    if (![state.outputs containsObject:output]) [state.outputs addObject:output];
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, output);
}
static void OrbitSession_removeOutput(AVCaptureSession *self, SEL _cmd, AVCaptureOutput *output) {
  OrbitSessionState *state = OrbitStateForSession(self, NO);
  if (state && [state.outputs containsObject:output]) {
    [state.outputs removeObject:output];
    OrbitConnection *c = [state connectionForOutput:output];
    if (c) [state.connections removeObject:c];
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, output);
}
static NSArray *OrbitSession_outputs(AVCaptureSession *self, SEL _cmd) {
  NSArray *original = @[];
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) original = ((NSArray * (*)(id, SEL))imp)(self, _cmd) ?: @[];
  OrbitSessionState *state = OrbitStateForSession(self, NO);
  return state ? [state.outputs arrayByAddingObjectsFromArray:original] : original;
}
static NSArray *OrbitSession_connections(AVCaptureSession *self, SEL _cmd) {
  NSArray *original = @[];
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) original = ((NSArray * (*)(id, SEL))imp)(self, _cmd) ?: @[];
  OrbitSessionState *state = OrbitStateForSession(self, NO);
  return state ? [state.connections arrayByAddingObjectsFromArray:original] : original;
}
static BOOL OrbitSession_canAddConnection(AVCaptureSession *self, SEL _cmd, AVCaptureConnection *connection) {
  if ([connection isKindOfClass:[OrbitConnection class]]) return YES;
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  return imp ? ((BOOL (*)(id, SEL, id))imp)(self, _cmd, connection) : NO;
}
static void OrbitSession_addConnection(AVCaptureSession *self, SEL _cmd, AVCaptureConnection *connection) {
  if ([connection isKindOfClass:[OrbitConnection class]]) {
    OrbitSessionState *state = OrbitStateForSession(self, YES);
    if (![state.connections containsObject:(OrbitConnection *)connection]) [state.connections addObject:(OrbitConnection *)connection];
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, connection);
}
static void OrbitSession_removeConnection(AVCaptureSession *self, SEL _cmd, AVCaptureConnection *connection) {
  if ([connection isKindOfClass:[OrbitConnection class]]) {
    [OrbitStateForSession(self, NO).connections removeObject:(OrbitConnection *)connection];
    return;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureSession class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, connection);
}
static BOOL OrbitSession_canSetSessionPreset(AVCaptureSession *self, SEL _cmd, NSString *preset) { return YES; }
static NSString *OrbitSession_sessionPreset(AVCaptureSession *self, SEL _cmd) {
  return OrbitStateForSession(self, YES).preset;
}
static void OrbitSession_setSessionPreset(AVCaptureSession *self, SEL _cmd, NSString *preset) {
  OrbitStateForSession(self, YES).preset = preset ?: AVCaptureSessionPresetHigh;
}
static void OrbitSession_beginConfiguration(AVCaptureSession *self, SEL _cmd) {}
static void OrbitSession_commitConfiguration(AVCaptureSession *self, SEL _cmd) {}
static BOOL OrbitSession_isRunning(AVCaptureSession *self, SEL _cmd) {
  return OrbitStateForSession(self, NO).running;
}
static BOOL OrbitSession_isInterrupted(AVCaptureSession *self, SEL _cmd) { return NO; }
static void OrbitSession_startRunning(AVCaptureSession *self, SEL _cmd) {
  OrbitSessionState *state = OrbitStateForSession(self, YES);
  if (state.running) return;
  state.running = YES;
  ORBIT_LOG(@"Session %p: start running (%lu outputs, %lu connections)", self,
            (unsigned long)state.outputs.count, (unsigned long)state.connections.count);
  [[NSNotificationCenter defaultCenter] postNotificationName:AVCaptureSessionDidStartRunningNotification object:self];
}
static void OrbitSession_stopRunning(AVCaptureSession *self, SEL _cmd) {
  OrbitSessionState *state = OrbitStateForSession(self, NO);
  if (!state || !state.running) return;
  state.running = NO;
  [[NSNotificationCenter defaultCenter] postNotificationName:AVCaptureSessionDidStopRunningNotification object:self];
}
