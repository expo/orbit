@interface OrbitOutputState : NSObject
@property (nonatomic, weak) id delegate;
@property (nonatomic, strong) dispatch_queue_t queue;
@property (nonatomic, copy) NSArray *metadataObjectTypes;
@property (nonatomic) CGRect rectOfInterest;
@property (nonatomic) BOOL inFlight;
@property (nonatomic) NSUInteger tickCount;
// Movie recording
@property (nonatomic, strong) AVAssetWriter *writer;
@property (nonatomic, strong) AVAssetWriterInput *writerInput;
@property (nonatomic, strong) AVAssetWriterInputPixelBufferAdaptor *adaptor;
@property (nonatomic, strong) NSURL *recordingURL;
@property (nonatomic, weak) id recordingDelegate;
@property (nonatomic) CMTime recordingStart;
@property (nonatomic) CMTime recordedDuration;
@property (nonatomic) BOOL recordingPaused;
@property (nonatomic) int64_t recordedFrames;
@end
@implementation OrbitOutputState
- (instancetype)init {
  if ((self = [super init])) _rectOfInterest = CGRectMake(0, 0, 1, 1);
  return self;
}
@end

static OrbitOutputState *OrbitStateForOutput(AVCaptureOutput *output) {
  OrbitOutputState *state = objc_getAssociatedObject(output, kOrbitOutputStateKey);
  if (!state) {
    state = [OrbitOutputState new];
    objc_setAssociatedObject(output, kOrbitOutputStateKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
  }
  return state;
}

static OrbitSessionState *OrbitSessionStateForOutput(AVCaptureOutput *output, AVCaptureSession **sessionOut) {
  [sSessionsLock lock];
  NSArray *sessions = sSessions.allObjects;
  [sSessionsLock unlock];
  for (AVCaptureSession *session in sessions) {
    OrbitSessionState *state = OrbitStateForSession(session, NO);
    if ([state.outputs containsObject:output]) {
      if (sessionOut) *sessionOut = session;
      return state;
    }
  }
  return nil;
}

// AVCaptureOutput
static NSArray *OrbitOutput_connections(AVCaptureOutput *self, SEL _cmd) {
  OrbitSessionState *state = OrbitSessionStateForOutput(self, NULL);
  OrbitConnection *c = [state connectionForOutput:self];
  if (c) return @[ c ];
  IMP imp = OrbitOriginalIMP([AVCaptureOutput class], _cmd, NO);
  return imp ? ((NSArray * (*)(id, SEL))imp)(self, _cmd) : @[];
}
static AVCaptureConnection *OrbitOutput_connectionWithMediaType(AVCaptureOutput *self, SEL _cmd, NSString *mediaType) {
  if (OrbitIsVideoMediaType(mediaType)) {
    OrbitConnection *c = [OrbitSessionStateForOutput(self, NULL) connectionForOutput:self];
    if (c) return c;
  }
  IMP imp = OrbitOriginalIMP([AVCaptureOutput class], _cmd, NO);
  return imp ? ((id (*)(id, SEL, id))imp)(self, _cmd, mediaType) : nil;
}
static CGRect OrbitOutput_metadataOutputRectOfInterestForRect(AVCaptureOutput *self, SEL _cmd, CGRect rect) {
  // Output coordinates are normalized with the origin at the top left of the unrotated
  // frame; this maps a normalized rect of interest as-is, which is right for a connection
  // without rotation and close enough for previews.
  return rect;
}
static CGRect OrbitOutput_rectForMetadataOutputRectOfInterest(AVCaptureOutput *self, SEL _cmd, CGRect rect) {
  return rect;
}
static AVMetadataObject *OrbitOutput_transformedMetadataObject(AVCaptureOutput *self, SEL _cmd, AVMetadataObject *object, AVCaptureConnection *connection) {
  return object;
}

