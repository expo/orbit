static void OrbitMovie_setOutputSettings(id self, SEL _cmd, NSDictionary *s, id c) {}

static void OrbitMovie_startRecording(AVCaptureMovieFileOutput *self, SEL _cmd, NSURL *url, id<AVCaptureFileOutputRecordingDelegate> delegate) {
  OrbitOutputState *state = OrbitStateForOutput(self);
  if (state.writer) return;
  [[NSFileManager defaultManager] removeItemAtURL:url error:nil];
  NSError *error = nil;
  AVAssetWriter *writer = [AVAssetWriter assetWriterWithURL:url fileType:AVFileTypeQuickTimeMovie error:&error];
  if (!writer) {
    ORBIT_LOG(@"Cannot start recording: %@", error);
    return;
  }
  OrbitConnection *connection = [OrbitSessionStateForOutput(self, NULL) connectionForOutput:self];
  BOOL portrait = connection ? ((int)lround(connection.orbitRotationAngle) % 180) == 90 : YES;
  NSDictionary *settings = @{
    AVVideoCodecKey : AVVideoCodecTypeH264,
    AVVideoWidthKey : @(portrait ? 1080 : 1920), AVVideoHeightKey : @(portrait ? 1920 : 1080),
  };
  AVAssetWriterInput *input = [AVAssetWriterInput assetWriterInputWithMediaType:AVMediaTypeVideo outputSettings:settings];
  input.expectsMediaDataInRealTime = YES;
  AVAssetWriterInputPixelBufferAdaptor *adaptor =
      [AVAssetWriterInputPixelBufferAdaptor assetWriterInputPixelBufferAdaptorWithAssetWriterInput:input
          sourcePixelBufferAttributes:@{ (id)kCVPixelBufferPixelFormatTypeKey : @(kCVPixelFormatType_32BGRA) }];
  [writer addInput:input];
  [writer startWriting];
  state.writer = writer;
  state.writerInput = input;
  state.adaptor = adaptor;
  state.recordingURL = url;
  state.recordingDelegate = delegate;
  state.recordingStart = kCMTimeInvalid;
  state.recordedDuration = kCMTimeZero;
  state.recordedFrames = 0;
  state.recordingPaused = NO;
  NSArray *connections = connection ? @[ connection ] : @[];
  dispatch_async(dispatch_get_main_queue(), ^{
    if ([delegate respondsToSelector:@selector(captureOutput:didStartRecordingToOutputFileAtURL:fromConnections:)]) {
      [delegate captureOutput:self didStartRecordingToOutputFileAtURL:url fromConnections:connections];
    }
  });
}
static void OrbitMovie_stopRecording(AVCaptureMovieFileOutput *self, SEL _cmd) {
  OrbitOutputState *state = OrbitStateForOutput(self);
  AVAssetWriter *writer = state.writer;
  if (!writer) return;
  AVAssetWriterInput *input = state.writerInput;
  NSURL *url = state.recordingURL;
  id<AVCaptureFileOutputRecordingDelegate> delegate = state.recordingDelegate;
  OrbitConnection *connection = [OrbitSessionStateForOutput(self, NULL) connectionForOutput:self];
  NSArray *connections = connection ? @[ connection ] : @[];
  state.writer = nil;
  state.writerInput = nil;
  state.adaptor = nil;
  [input markAsFinished];
  [writer finishWritingWithCompletionHandler:^{
    dispatch_async(dispatch_get_main_queue(), ^{
      if ([delegate respondsToSelector:@selector(captureOutput:didFinishRecordingToOutputFileAtURL:fromConnections:error:)]) {
        [delegate captureOutput:self didFinishRecordingToOutputFileAtURL:url fromConnections:connections error:writer.error];
      }
    });
  }];
}
static void OrbitMovie_pauseRecording(AVCaptureMovieFileOutput *self, SEL _cmd) { OrbitStateForOutput(self).recordingPaused = YES; }
static void OrbitMovie_resumeRecording(AVCaptureMovieFileOutput *self, SEL _cmd) { OrbitStateForOutput(self).recordingPaused = NO; }

static void OrbitMovieAppendFrame(AVCaptureMovieFileOutput *output, OrbitOutputState *state, CVPixelBufferRef frame) {
  if (!state.writer || state.recordingPaused || !state.writerInput.readyForMoreMediaData) return;
  CMTime now = CMClockGetTime(CMClockGetHostTimeClock());
  if (!CMTIME_IS_VALID(state.recordingStart)) {
    state.recordingStart = now;
    [state.writer startSessionAtSourceTime:now];
  }
  if ([state.adaptor appendPixelBuffer:frame withPresentationTime:now]) {
    state.recordedFrames++;
    state.recordedDuration = CMTimeSubtract(now, state.recordingStart);
  }
}

#pragma mark - Preview layer

@interface OrbitPreviewState : NSObject
@property (nonatomic, weak) AVCaptureSession *session;
@property (nonatomic, strong) AVSampleBufferDisplayLayer *displayLayer;
@property (nonatomic) BOOL withoutConnection;
@end
@implementation OrbitPreviewState
@end

static OrbitPreviewState *OrbitStateForPreview(AVCaptureVideoPreviewLayer *layer, BOOL create) {
  OrbitPreviewState *state = objc_getAssociatedObject(layer, kOrbitPreviewStateKey);
  if (!state && create) {
    state = [OrbitPreviewState new];
    objc_setAssociatedObject(layer, kOrbitPreviewStateKey, state, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
  }
  return state;
}

static void OrbitPreviewAttach(AVCaptureVideoPreviewLayer *layer, AVCaptureSession *session, BOOL withoutConnection) {
  OrbitPreviewState *state = OrbitStateForPreview(layer, YES);
  if (state.session && state.session != session) {
    OrbitSessionState *old = OrbitStateForSession(state.session, NO);
    [old.previewLayers removeObject:layer];
    OrbitConnection *c = [old connectionForPreviewLayer:layer];
    if (c) [old.connections removeObject:c];
  }
  state.session = session;
  state.withoutConnection = withoutConnection;
  if (!state.displayLayer) {
    AVSampleBufferDisplayLayer *display = [AVSampleBufferDisplayLayer layer];
    display.videoGravity = layer.videoGravity ?: AVLayerVideoGravityResizeAspectFill;
    display.frame = layer.bounds;
    [layer addSublayer:display];
    state.displayLayer = display;
  }
  if (session) {
    OrbitSessionState *sessionState = OrbitStateForSession(session, YES);
    [sessionState.previewLayers addObject:layer];
    if (!withoutConnection) OrbitConnectIfNeeded(session, sessionState);
  }
}

// The original initializers and setters connect the layer to the session's inputs through
// AVFoundation's internals, which cannot handle the virtual input. The layer is created
// without a session and the connection is kept here instead.
static AVCaptureVideoPreviewLayer *OrbitPreviewInitBare(AVCaptureVideoPreviewLayer *self) {
  // The initializers chain into each other (init → initWithSession: → the no-connection
  // one); the no-connection initializer with a nil session sets the layer up and connects
  // nothing. The guard covers a chain that comes back through a swizzled initializer.
  static __thread BOOL inBareInit = NO;
  if (inBareInit) {
    IMP layerInit = class_getMethodImplementation([CALayer class], @selector(init));
    return ((id (*)(id, SEL))layerInit)(self, @selector(init));
  }
  inBareInit = YES;
  SEL bare = @selector(initWithSessionWithNoConnection:);
  IMP imp = OrbitOriginalIMP([AVCaptureVideoPreviewLayer class], bare, NO);
  AVCaptureVideoPreviewLayer *layer = imp ? ((id (*)(id, SEL, id))imp)(self, bare, nil) : self;
  inBareInit = NO;
  return layer;
}
static id OrbitPreview_initWithSession(AVCaptureVideoPreviewLayer *self, SEL _cmd, AVCaptureSession *session) {
  AVCaptureVideoPreviewLayer *layer = OrbitPreviewInitBare(self);
  if (layer) OrbitPreviewAttach(layer, session, NO);
  return layer;
}
static id OrbitPreview_initWithSessionWithNoConnection(AVCaptureVideoPreviewLayer *self, SEL _cmd, AVCaptureSession *session) {
  AVCaptureVideoPreviewLayer *layer = OrbitPreviewInitBare(self);
  if (layer) OrbitPreviewAttach(layer, session, YES);
  return layer;
}
static id OrbitPreview_init(AVCaptureVideoPreviewLayer *self, SEL _cmd) {
  AVCaptureVideoPreviewLayer *layer = OrbitPreviewInitBare(self);
  if (layer) OrbitStateForPreview(layer, YES);
  return layer;
}
static void OrbitPreview_setSession(AVCaptureVideoPreviewLayer *self, SEL _cmd, AVCaptureSession *session) {
  OrbitPreviewAttach(self, session, NO);
}
static void OrbitPreview_setSessionWithNoConnection(AVCaptureVideoPreviewLayer *self, SEL _cmd, AVCaptureSession *session) {
  OrbitPreviewAttach(self, session, YES);
}
static AVCaptureSession *OrbitPreview_session(AVCaptureVideoPreviewLayer *self, SEL _cmd) {
  return OrbitStateForPreview(self, NO).session;
}
static AVCaptureConnection *OrbitPreview_connection(AVCaptureVideoPreviewLayer *self, SEL _cmd) {
  OrbitPreviewState *state = OrbitStateForPreview(self, NO);
  OrbitSessionState *sessionState = state.session ? OrbitStateForSession(state.session, NO) : nil;
  return [sessionState connectionForPreviewLayer:self];
}
static void OrbitPreview_setVideoGravity(AVCaptureVideoPreviewLayer *self, SEL _cmd, NSString *gravity) {
  IMP imp = OrbitOriginalIMP([AVCaptureVideoPreviewLayer class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, id))imp)(self, _cmd, gravity);
  OrbitStateForPreview(self, NO).displayLayer.videoGravity = gravity ?: AVLayerVideoGravityResizeAspect;
}
static void OrbitPreview_layoutSublayers(AVCaptureVideoPreviewLayer *self, SEL _cmd) {
  IMP imp = OrbitOriginalIMP([AVCaptureVideoPreviewLayer class], _cmd, NO);
  if (imp) ((void (*)(id, SEL))imp)(self, _cmd);
  OrbitPreviewState *state = OrbitStateForPreview(self, NO);
  if (state.displayLayer) {
    [CATransaction begin];
    [CATransaction setDisableActions:YES];
    state.displayLayer.frame = self.bounds;
    [CATransaction commit];
  }
}
static BOOL OrbitPreview_isPreviewing(AVCaptureVideoPreviewLayer *self, SEL _cmd) {
  OrbitPreviewState *state = OrbitStateForPreview(self, NO);
  return state.session ? OrbitStateForSession(state.session, NO).running : NO;
}
// Layer point ↔ normalized device point. The display layer shows the frame with the gravity
// of the preview layer; these map through the rect the video occupies.
static CGRect OrbitPreviewVideoRect(AVCaptureVideoPreviewLayer *layer) {
  CGRect bounds = layer.bounds;
  OrbitPreviewState *state = OrbitStateForPreview(layer, NO);
  OrbitConnection *c = (OrbitConnection *)OrbitPreview_connection(layer, @selector(connection));
  BOOL portrait = c ? ((int)lround(c.orbitRotationAngle) % 180) == 90 : YES;
  CGFloat videoAspect = portrait ? 9.0 / 16.0 : 16.0 / 9.0;
  if (!state.displayLayer || CGRectIsEmpty(bounds)) return bounds;
  NSString *gravity = layer.videoGravity;
  if ([gravity isEqualToString:AVLayerVideoGravityResize]) return bounds;
  CGFloat boundsAspect = bounds.size.width / bounds.size.height;
  BOOL fill = [gravity isEqualToString:AVLayerVideoGravityResizeAspectFill];
  CGFloat w, h;
  if ((videoAspect > boundsAspect) != fill) {
    w = bounds.size.width;
    h = w / videoAspect;
  } else {
    h = bounds.size.height;
    w = h * videoAspect;
  }
  return CGRectMake(CGRectGetMidX(bounds) - w / 2, CGRectGetMidY(bounds) - h / 2, w, h);
}
static CGPoint OrbitPreview_captureDevicePointOfInterestForPoint(AVCaptureVideoPreviewLayer *self, SEL _cmd, CGPoint point) {
  CGRect rect = OrbitPreviewVideoRect(self);
  if (rect.size.width <= 0 || rect.size.height <= 0) return CGPointMake(0.5, 0.5);
  return CGPointMake((point.x - rect.origin.x) / rect.size.width, (point.y - rect.origin.y) / rect.size.height);
}
static CGPoint OrbitPreview_pointForCaptureDevicePointOfInterest(AVCaptureVideoPreviewLayer *self, SEL _cmd, CGPoint point) {
  CGRect rect = OrbitPreviewVideoRect(self);
  return CGPointMake(rect.origin.x + point.x * rect.size.width, rect.origin.y + point.y * rect.size.height);
}
static CGRect OrbitPreview_metadataOutputRectOfInterestForRect(AVCaptureVideoPreviewLayer *self, SEL _cmd, CGRect rect) {
  CGPoint origin = OrbitPreview_captureDevicePointOfInterestForPoint(self, _cmd, rect.origin);
  CGPoint end = OrbitPreview_captureDevicePointOfInterestForPoint(self, _cmd, CGPointMake(CGRectGetMaxX(rect), CGRectGetMaxY(rect)));
  return CGRectMake(origin.x, origin.y, end.x - origin.x, end.y - origin.y);
}
static CGRect OrbitPreview_rectForMetadataOutputRectOfInterest(AVCaptureVideoPreviewLayer *self, SEL _cmd, CGRect rect) {
  CGPoint origin = OrbitPreview_pointForCaptureDevicePointOfInterest(self, _cmd, rect.origin);
  CGPoint end = OrbitPreview_pointForCaptureDevicePointOfInterest(self, _cmd, CGPointMake(CGRectGetMaxX(rect), CGRectGetMaxY(rect)));
  return CGRectMake(origin.x, origin.y, end.x - origin.x, end.y - origin.y);
}
static AVMetadataObject *OrbitPreview_transformedMetadataObject(AVCaptureVideoPreviewLayer *self, SEL _cmd, AVMetadataObject *object) {
  if (![object isKindOfClass:[OrbitMetadataObject class]]) return object;
  OrbitMetadataObject *source = (OrbitMetadataObject *)object;
  OrbitMetadataObject *result = [OrbitMetadataObject alloc];
  result.orbitType = source.orbitType;
  result.orbitValue = source.orbitValue;
  result.orbitTime = source.orbitTime;
  result.orbitBounds = OrbitPreview_rectForMetadataOutputRectOfInterest(self, _cmd, source.orbitBounds);
  NSMutableArray *corners = [NSMutableArray new];
  for (NSDictionary *corner in source.orbitCorners) {
    CGPoint p = OrbitPreview_pointForCaptureDevicePointOfInterest(
        self, _cmd, CGPointMake([corner[@"X"] doubleValue], [corner[@"Y"] doubleValue]));
    [corners addObject:@{ @"X" : @(p.x), @"Y" : @(p.y) }];
  }
  result.orbitCorners = corners;
  return result;
}

#pragma mark - Frame delivery

static NSString *sFramesDirectory;
static OrbitFrameReader *sFrontReader, *sBackReader;
static CVPixelBufferRef sFrontPlaceholder, sBackPlaceholder;
static dispatch_queue_t sTickQueue;
static dispatch_source_t sTimer;

CVPixelBufferRef OrbitCurrentFrameForPosition(AVCaptureDevicePosition position, BOOL *sourceMirrored) {
  OrbitFrameReader *reader = position == AVCaptureDevicePositionFront ? sFrontReader : sBackReader;
  CVPixelBufferRef frame = [reader copyCurrentFrame:sourceMirrored];
  if (frame) return frame;
  CVPixelBufferRef *placeholder = position == AVCaptureDevicePositionFront ? &sFrontPlaceholder : &sBackPlaceholder;
  if (!*placeholder) *placeholder = OrbitCreatePlaceholderFrame(position);
  if (sourceMirrored) *sourceMirrored = NO;
  return *placeholder ? (CVPixelBufferRef)CFRetain(*placeholder) : NULL;
}

// A frame rotated for a connection, computed at most once per tick per orientation.
@interface OrbitTickCache : NSObject
@property (nonatomic, strong) NSMutableDictionary<NSString *, id> *buffers;
@end
@implementation OrbitTickCache
@end

static CVPixelBufferRef OrbitOrientedFrameForConnection(NSMutableDictionary *cache, OrbitConnection *connection) {
  AVCaptureDevicePosition position = connection.orbitPosition;
  NSString *sourceKey = position == AVCaptureDevicePositionFront ? @"front" : @"back";
  NSNumber *mirroredFlag = cache[[sourceKey stringByAppendingString:@".mirrored"]];
  CVPixelBufferRef source = (__bridge CVPixelBufferRef)cache[sourceKey];
  if (!source) {
    BOOL sourceMirrored = NO;
    source = OrbitCurrentFrameForPosition(position, &sourceMirrored);
    if (!source) return NULL;
    cache[sourceKey] = (__bridge_transfer id)source;
    mirroredFlag = @(sourceMirrored);
    cache[[sourceKey stringByAppendingString:@".mirrored"]] = mirroredFlag;
  }
  BOOL mirror = connection.orbitMirrored && !mirroredFlag.boolValue;
  NSString *key = [NSString stringWithFormat:@"%@.%.0f.%d", sourceKey, connection.orbitRotationAngle, mirror];
  CVPixelBufferRef oriented = (__bridge CVPixelBufferRef)cache[key];
  if (!oriented) {
    oriented = OrbitCreateOrientedFrame(source, connection.orbitRotationAngle, mirror);
    if (!oriented) return NULL;
    cache[key] = (__bridge_transfer id)oriented;
  }
  return oriented;
}

static void OrbitDeliverFrames(void) {
  [sSessionsLock lock];
  NSArray *sessions = sSessions.allObjects;
  [sSessionsLock unlock];
  NSMutableDictionary *cache = [NSMutableDictionary new];
  CMTime pts = CMClockGetTime(CMClockGetHostTimeClock());

  for (AVCaptureSession *session in sessions) {
    OrbitSessionState *state = OrbitStateForSession(session, NO);
    if (!state.running || !state.videoInput) continue;
    for (OrbitConnection *connection in [state.connections copy]) {
      if (!connection.orbitEnabled) continue;
      AVCaptureOutput *output = connection.orbitOutput;
      AVCaptureVideoPreviewLayer *previewLayer = connection.orbitPreviewLayer;

      if (previewLayer) {
        OrbitPreviewState *preview = OrbitStateForPreview(previewLayer, NO);
        AVSampleBufferDisplayLayer *display = preview.displayLayer;
        if (!display || previewLayer.hidden) continue;
        CVPixelBufferRef frame = OrbitOrientedFrameForConnection(cache, connection);
        CMSampleBufferRef sample = OrbitCreateSampleBuffer(frame, pts);
        if (sample) {
          CFArrayRef attachments = CMSampleBufferGetSampleAttachmentsArray(sample, true);
          if (attachments && CFArrayGetCount(attachments) > 0) {
            CFMutableDictionaryRef dict = (CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0);
            CFDictionarySetValue(dict, kCMSampleAttachmentKey_DisplayImmediately, kCFBooleanTrue);
          }
          if (display.status == AVQueuedSampleBufferRenderingStatusFailed) [display flush];
          if (display.isReadyForMoreMediaData) [display enqueueSampleBuffer:sample];
          CFRelease(sample);
        }
        continue;
      }
      if (!output) continue;
      OrbitOutputState *outputState = OrbitStateForOutput(output);
      outputState.tickCount++;

      if ([output isKindOfClass:[AVCaptureVideoDataOutput class]]) {
        id<AVCaptureVideoDataOutputSampleBufferDelegate> delegate = outputState.delegate;
        if (!delegate || !outputState.queue || outputState.inFlight) continue;
        CVPixelBufferRef frame = OrbitOrientedFrameForConnection(cache, connection);
        CMSampleBufferRef sample = OrbitCreateSampleBuffer(frame, pts);
        if (!sample) continue;
        outputState.inFlight = YES;
        dispatch_async(outputState.queue, ^{
          if ([delegate respondsToSelector:@selector(captureOutput:didOutputSampleBuffer:fromConnection:)]) {
            [delegate captureOutput:output didOutputSampleBuffer:sample fromConnection:connection];
          }
          CFRelease(sample);
          outputState.inFlight = NO;
        });
      } else if ([output isKindOfClass:[AVCaptureMetadataOutput class]]) {
        // Detect about three times a second: enough for a scanner, cheap enough for the CPU.
        if (outputState.tickCount % 10 != 0) continue;
        id<AVCaptureMetadataOutputObjectsDelegate> delegate = outputState.delegate;
        if (!delegate || !outputState.queue || outputState.inFlight) continue;
        if (![outputState.metadataObjectTypes containsObject:AVMetadataObjectTypeQRCode]) continue;
        CVPixelBufferRef frame = OrbitOrientedFrameForConnection(cache, connection);
        if (!frame) continue;
        CVBufferRetain(frame);
        outputState.inFlight = YES;
        dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
          NSArray *objects = OrbitDetectCodes(frame, connection.orbitRotationAngle, connection.orbitMirrored);
          CVBufferRelease(frame);
          if (objects.count == 0) {
            outputState.inFlight = NO;
            return;
          }
          dispatch_async(outputState.queue, ^{
            if ([delegate respondsToSelector:@selector(captureOutput:didOutputMetadataObjects:fromConnection:)]) {
              [delegate captureOutput:output didOutputMetadataObjects:objects fromConnection:connection];
            }
            outputState.inFlight = NO;
          });
        });
      } else if ([output isKindOfClass:[AVCaptureMovieFileOutput class]]) {
        if (!outputState.writer) continue;
        CVPixelBufferRef frame = OrbitOrientedFrameForConnection(cache, connection);
        if (frame) OrbitMovieAppendFrame((AVCaptureMovieFileOutput *)output, outputState, frame);
      }
    }
  }
}

static void OrbitStartFrameTimer(void) {
  sTickQueue = dispatch_queue_create("dev.expo.orbit.simulator-camera.frames", DISPATCH_QUEUE_SERIAL);
  sTimer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, sTickQueue);
  dispatch_source_set_timer(sTimer, dispatch_time(DISPATCH_TIME_NOW, 0), NSEC_PER_SEC / kOrbitFrameRate, NSEC_PER_MSEC * 2);
  dispatch_source_set_event_handler(sTimer, ^{
    @autoreleasepool {
      OrbitDeliverFrames();
    }
  });
  dispatch_resume(sTimer);
}

#pragma mark - UIImagePickerController

// A minimal camera UI for apps that use the system picker: the preview with Cancel and a
// shutter button. Returns the frame as UIImagePickerControllerOriginalImage.
@interface OrbitPickerCameraController : UIViewController
@property (nonatomic, weak) UIImagePickerController *picker;
@property (nonatomic, strong) AVSampleBufferDisplayLayer *displayLayer;
@property (nonatomic, strong) dispatch_source_t timer;
@property (nonatomic) AVCaptureDevicePosition position;
@end
@implementation OrbitPickerCameraController
- (void)viewDidLoad {
  [super viewDidLoad];
  self.view.backgroundColor = [UIColor blackColor];
  _displayLayer = [AVSampleBufferDisplayLayer layer];
  _displayLayer.videoGravity = AVLayerVideoGravityResizeAspectFill;
  [self.view.layer addSublayer:_displayLayer];

  UIButton *cancel = [UIButton buttonWithType:UIButtonTypeSystem];
  [cancel setTitle:@"Cancel" forState:UIControlStateNormal];
  cancel.tintColor = [UIColor whiteColor];
  cancel.titleLabel.font = [UIFont systemFontOfSize:18];
  [cancel addTarget:self action:@selector(cancel) forControlEvents:UIControlEventTouchUpInside];
  cancel.translatesAutoresizingMaskIntoConstraints = NO;
  [self.view addSubview:cancel];

  UIButton *shutter = [UIButton buttonWithType:UIButtonTypeCustom];
  shutter.backgroundColor = [UIColor whiteColor];
  shutter.layer.cornerRadius = 36;
  shutter.layer.borderColor = [UIColor colorWithWhite:0.8 alpha:1].CGColor;
  shutter.layer.borderWidth = 4;
  [shutter addTarget:self action:@selector(capture) forControlEvents:UIControlEventTouchUpInside];
  shutter.translatesAutoresizingMaskIntoConstraints = NO;
  [self.view addSubview:shutter];

  UIButton *flip = [UIButton buttonWithType:UIButtonTypeSystem];
  [flip setTitle:@"Flip" forState:UIControlStateNormal];
  flip.tintColor = [UIColor whiteColor];
  flip.titleLabel.font = [UIFont systemFontOfSize:18];
  [flip addTarget:self action:@selector(flip) forControlEvents:UIControlEventTouchUpInside];
  flip.translatesAutoresizingMaskIntoConstraints = NO;
  [self.view addSubview:flip];

  UILayoutGuide *safe = self.view.safeAreaLayoutGuide;
  [NSLayoutConstraint activateConstraints:@[
    [cancel.leadingAnchor constraintEqualToAnchor:safe.leadingAnchor constant:20],
    [cancel.bottomAnchor constraintEqualToAnchor:safe.bottomAnchor constant:-32],
    [flip.trailingAnchor constraintEqualToAnchor:safe.trailingAnchor constant:-20],
    [flip.bottomAnchor constraintEqualToAnchor:safe.bottomAnchor constant:-32],
    [shutter.centerXAnchor constraintEqualToAnchor:safe.centerXAnchor],
    [shutter.bottomAnchor constraintEqualToAnchor:safe.bottomAnchor constant:-16],
    [shutter.widthAnchor constraintEqualToConstant:72],
    [shutter.heightAnchor constraintEqualToConstant:72],
  ]];

  _timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
  dispatch_source_set_timer(_timer, DISPATCH_TIME_NOW, NSEC_PER_SEC / kOrbitFrameRate, NSEC_PER_MSEC * 2);
  __weak typeof(self) weakSelf = self;
  dispatch_source_set_event_handler(_timer, ^{ [weakSelf renderFrame]; });
  dispatch_resume(_timer);
}
- (void)viewDidLayoutSubviews {
  [super viewDidLayoutSubviews];
  _displayLayer.frame = self.view.bounds;
}
- (CVPixelBufferRef)copyOrientedFrame {
  BOOL sourceMirrored = NO;
  CVPixelBufferRef source = OrbitCurrentFrameForPosition(_position, &sourceMirrored);
  CVPixelBufferRef oriented = OrbitCreateOrientedFrame(source, 90, _position == AVCaptureDevicePositionFront && !sourceMirrored);
  if (source) CVBufferRelease(source);
  return oriented;
}
- (void)renderFrame {
  CVPixelBufferRef frame = [self copyOrientedFrame];
  CMSampleBufferRef sample = OrbitCreateSampleBuffer(frame, CMClockGetTime(CMClockGetHostTimeClock()));
  if (frame) CVBufferRelease(frame);
  if (!sample) return;
  CFArrayRef attachments = CMSampleBufferGetSampleAttachmentsArray(sample, true);
  if (attachments && CFArrayGetCount(attachments) > 0) {
    CFDictionarySetValue((CFMutableDictionaryRef)CFArrayGetValueAtIndex(attachments, 0), kCMSampleAttachmentKey_DisplayImmediately, kCFBooleanTrue);
  }
  if (_displayLayer.status == AVQueuedSampleBufferRenderingStatusFailed) [_displayLayer flush];
  if (_displayLayer.isReadyForMoreMediaData) [_displayLayer enqueueSampleBuffer:sample];
  CFRelease(sample);
}
- (void)dealloc {
  if (_timer) dispatch_source_cancel(_timer);
}
- (void)cancel {
  UIImagePickerController *picker = _picker;
  id<UIImagePickerControllerDelegate> delegate = (id)picker.delegate;
  if ([delegate respondsToSelector:@selector(imagePickerControllerDidCancel:)]) {
    [delegate imagePickerControllerDidCancel:picker];
  } else {
    [picker.presentingViewController dismissViewControllerAnimated:YES completion:nil];
  }
}
- (void)flip {
  _position = _position == AVCaptureDevicePositionFront ? AVCaptureDevicePositionBack : AVCaptureDevicePositionFront;
}
- (void)capture {
  CVPixelBufferRef frame = [self copyOrientedFrame];
  CGImageRef cgImage = OrbitCreateCGImage(frame);
  if (frame) CVBufferRelease(frame);
  if (!cgImage) return;
  UIImage *image = [UIImage imageWithCGImage:cgImage];
  CGImageRelease(cgImage);
  UIImagePickerController *picker = _picker;
  id<UIImagePickerControllerDelegate> delegate = (id)picker.delegate;
  NSDictionary *info = @{
    UIImagePickerControllerOriginalImage : image,
    UIImagePickerControllerMediaType : @"public.image",
  };
  if ([delegate respondsToSelector:@selector(imagePickerController:didFinishPickingMediaWithInfo:)]) {
    [delegate imagePickerController:picker didFinishPickingMediaWithInfo:info];
  } else {
    [picker.presentingViewController dismissViewControllerAnimated:YES completion:nil];
  }
}
@end

static BOOL OrbitPicker_isSourceTypeAvailable(id self, SEL _cmd, UIImagePickerControllerSourceType type) {
  if (type == UIImagePickerControllerSourceTypeCamera) return YES;
  IMP imp = OrbitOriginalIMP([UIImagePickerController class], _cmd, YES);
  return imp ? ((BOOL (*)(id, SEL, UIImagePickerControllerSourceType))imp)(self, _cmd, type) : NO;
}
static BOOL OrbitPicker_isCameraDeviceAvailable(id self, SEL _cmd, UIImagePickerControllerCameraDevice device) { return YES; }
static BOOL OrbitPicker_isFlashAvailableForCameraDevice(id self, SEL _cmd, UIImagePickerControllerCameraDevice device) { return NO; }
static NSArray *OrbitPicker_availableMediaTypesForSourceType(id self, SEL _cmd, UIImagePickerControllerSourceType type) {
  if (type == UIImagePickerControllerSourceTypeCamera) return @[ @"public.image" ];
  IMP imp = OrbitOriginalIMP([UIImagePickerController class], _cmd, YES);
  return imp ? ((NSArray * (*)(id, SEL, UIImagePickerControllerSourceType))imp)(self, _cmd, type) : nil;
}
static NSArray *OrbitPicker_availableCaptureModesForCameraDevice(id self, SEL _cmd, UIImagePickerControllerCameraDevice device) {
  return @[ @(UIImagePickerControllerCameraCaptureModePhoto) ];
}
static void OrbitPicker_setSourceType(UIImagePickerController *self, SEL _cmd, UIImagePickerControllerSourceType type) {
  if (type == UIImagePickerControllerSourceTypeCamera) {
    objc_setAssociatedObject(self, kOrbitPickerStateKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    return;  // The original throws on a simulator: the camera source is unavailable there.
  }
  objc_setAssociatedObject(self, kOrbitPickerStateKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
  IMP imp = OrbitOriginalIMP([UIImagePickerController class], _cmd, NO);
  if (imp) ((void (*)(id, SEL, UIImagePickerControllerSourceType))imp)(self, _cmd, type);
}
static UIImagePickerControllerSourceType OrbitPicker_sourceType(UIImagePickerController *self, SEL _cmd) {
  if (objc_getAssociatedObject(self, kOrbitPickerStateKey)) return UIImagePickerControllerSourceTypeCamera;
  IMP imp = OrbitOriginalIMP([UIImagePickerController class], _cmd, NO);
  return imp ? ((UIImagePickerControllerSourceType (*)(id, SEL))imp)(self, _cmd) : UIImagePickerControllerSourceTypePhotoLibrary;
}
static void OrbitPicker_viewDidLoad(UIImagePickerController *self, SEL _cmd) {
  IMP imp = OrbitOriginalIMP([UIImagePickerController class], _cmd, NO);
  if (imp) ((void (*)(id, SEL))imp)(self, _cmd);
  if (!objc_getAssociatedObject(self, kOrbitPickerStateKey)) return;
  OrbitPickerCameraController *camera = [OrbitPickerCameraController new];
  camera.picker = self;
  camera.position = self.cameraDevice == UIImagePickerControllerCameraDeviceFront ? AVCaptureDevicePositionFront : AVCaptureDevicePositionBack;
  [self setNavigationBarHidden:YES animated:NO];
  [self setViewControllers:@[ camera ] animated:NO];
}

