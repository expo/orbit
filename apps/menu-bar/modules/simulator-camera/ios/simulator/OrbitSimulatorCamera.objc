  OrbitOutputState *state = OrbitStateForOutput(self);
  if (!state.recordingURL) return 0;
  return [[[NSFileManager defaultManager] attributesOfItemAtPath:state.recordingURL.path error:nil] fileSize];
}
static NSArray *OrbitMovie_availableVideoCodecTypes(id self, SEL _cmd) { return @[ AVVideoCodecTypeH264 ]; }
static NSArray *OrbitMovie_supportedOutputSettingsKeysForConnection(id self, SEL _cmd, id c) { return @[ AVVideoCodecKey ]; }
