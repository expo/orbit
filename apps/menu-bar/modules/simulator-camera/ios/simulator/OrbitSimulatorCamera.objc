static int64_t sPhotoUniqueID = 1;

static void OrbitPhoto_capturePhotoWithSettings(AVCapturePhotoOutput *self, SEL _cmd, AVCapturePhotoSettings *settings,
                                                id<AVCapturePhotoCaptureDelegate> delegate) {
  AVCaptureSession *session = nil;
  OrbitSessionState *sessionState = OrbitSessionStateForOutput(self, &session);
  OrbitConnection *connection = [sessionState connectionForOutput:self];
  AVCaptureDevicePosition position = connection ? connection.orbitPosition : AVCaptureDevicePositionBack;
  CGFloat angle = connection ? connection.orbitRotationAngle : kOrbitDefaultRotationAngle;
  BOOL mirrored = connection ? connection.orbitMirrored : NO;

  OrbitResolvedPhotoSettings *resolved = [OrbitResolvedPhotoSettings alloc];
  resolved.orbitUniqueID = settings ? settings.uniqueID : sPhotoUniqueID++;

  extern CVPixelBufferRef OrbitCurrentFrameForPosition(AVCaptureDevicePosition position, BOOL *sourceMirrored);
  BOOL sourceMirrored = NO;
  CVPixelBufferRef source = OrbitCurrentFrameForPosition(position, &sourceMirrored);
  CVPixelBufferRef oriented = OrbitCreateOrientedFrame(source, angle, mirrored && !sourceMirrored);
  if (source) CVBufferRelease(source);
  resolved.orbitDimensions = (CMVideoDimensions){ (int32_t)CVPixelBufferGetWidth(oriented), (int32_t)CVPixelBufferGetHeight(oriented) };

  OrbitCapturePhoto *photo = [OrbitCapturePhoto alloc];
  photo.orbitPixelBuffer = oriented;  // Retained; released in dealloc.
  photo.orbitSettings = resolved;
  photo.orbitTimestamp = CMClockGetTime(CMClockGetHostTimeClock());
  photo.orbitRotationAngle = angle;

  // AVFoundation calls the delegate on an internal queue, in this order.
  dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
    if ([delegate respondsToSelector:@selector(captureOutput:willBeginCaptureForResolvedSettings:)]) {
      [delegate captureOutput:self willBeginCaptureForResolvedSettings:resolved];
    }
    if ([delegate respondsToSelector:@selector(captureOutput:willCapturePhotoForResolvedSettings:)]) {
      [delegate captureOutput:self willCapturePhotoForResolvedSettings:resolved];
    }
    if ([delegate respondsToSelector:@selector(captureOutput:didCapturePhotoForResolvedSettings:)]) {
      [delegate captureOutput:self didCapturePhotoForResolvedSettings:resolved];
    }
    if ([delegate respondsToSelector:@selector(captureOutput:didFinishProcessingPhoto:error:)]) {
      [delegate captureOutput:self didFinishProcessingPhoto:photo error:nil];
    }
    if ([delegate respondsToSelector:@selector(captureOutput:didFinishCaptureForResolvedSettings:error:)]) {
      [delegate captureOutput:self didFinishCaptureForResolvedSettings:resolved error:nil];
    }
  });
}
