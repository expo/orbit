// Orbit Simulator Camera: a virtual camera for apps running in the iOS Simulator.
//
// Orbit sets DYLD_INSERT_LIBRARIES in a booted simulator's launchd environment so that
// this library loads into every app the simulator launches afterwards. The library
// swizzles the AVFoundation capture classes, which have no camera on a simulator, so an
// app sees one front and one back camera, and feeds them frames that Orbit writes into a
// shared-memory file (see OrbitCameraShared.h). Apps need no changes.
//
// What is covered:
// - AVCaptureDevice discovery and authorization
// - AVCaptureSession inputs, outputs and connections for the virtual devices
// - AVCaptureVideoDataOutput sample buffers (BGRA, rotated for the connection)
// - AVCaptureVideoPreviewLayer rendering
// - AVCapturePhotoOutput still captures
// - AVCaptureMetadataOutput QR codes (CIDetector on the frames)
// - AVCaptureMovieFileOutput recordings (video only)
// - UIImagePickerController with the camera source
//
// Environment (set by Orbit in the simulator's launchd):
//   ORBIT_SIMULATOR_CAMERA_DIR    directory of the front.shm and back.shm frame files
//   ORBIT_SIMULATOR_CAMERA_LOG=1  log to the system log
//   ORBIT_SIMULATOR_CAMERA_FORCE=1  also load into Apple's apps and non-UIKit processes
//
// Build: see DylibBuilder.swift. The library is compiled against the iOS Simulator SDK that
// is installed on the machine, so it follows the user's Xcode.
// The file is Objective-C; the .objc extension keeps it out of the source-file globs of the
// pod and of Xcode, so nothing compiles it as part of Orbit itself.

#import <AVFoundation/AVFoundation.h>
#import <CoreImage/CoreImage.h>
#import <CoreMedia/CoreMedia.h>
#import <CoreVideo/CoreVideo.h>
#import <ImageIO/ImageIO.h>
#import <UIKit/UIKit.h>
#import <objc/message.h>
#import <objc/runtime.h>

#include <fcntl.h>
#include <mach/mach_time.h>
#include <sys/mman.h>
#include <sys/stat.h>
#include <unistd.h>

#include "OrbitCameraShared.h"

#pragma mark - Logging

static BOOL sVerbose = NO;

#define ORBIT_LOG(fmt, ...)                                     \
  do {                                                          \
    if (sVerbose) NSLog(@"[OrbitSimulatorCamera] " fmt, ##__VA_ARGS__); \
  } while (0)

#pragma mark - Constants

static NSString *const kOrbitFrontDeviceID = @"dev.expo.orbit.simulator-camera.front";
static NSString *const kOrbitBackDeviceID = @"dev.expo.orbit.simulator-camera.back";
static const int32_t kOrbitFrameRate = 30;
static const CGFloat kOrbitDefaultRotationAngle = 90;  // Portrait, like a phone held upright.

#pragma mark - Swizzling

// The original implementations, keyed by "Class.selector" ("+Class.selector" for class
// methods). Swizzled methods call these to pass through.
static NSMutableDictionary<NSString *, NSValue *> *sOriginalIMPs;

static NSString *OrbitIMPKey(Class cls, SEL sel, BOOL classMethod) {
  return [NSString stringWithFormat:@"%@%@.%@", classMethod ? @"+" : @"",
                                    NSStringFromClass(cls), NSStringFromSelector(sel)];
}

static IMP OrbitOriginalIMP(Class cls, SEL sel, BOOL classMethod) {
  return (IMP)[sOriginalIMPs[OrbitIMPKey(cls, sel, classMethod)] pointerValue];
}

// Replaces `sel` of `cls` with `replacement`. When the class does not implement the selector
// itself but inherits it, the replacement is added to the class so the superclass keeps its
// own behavior. A selector the class does not respond to at all is added too, so apps that
// query newer API get an answer.
static void OrbitSwizzle(Class cls, SEL sel, IMP replacement, const char *types, BOOL classMethod) {
  if (cls == Nil) return;
  Class target = classMethod ? object_getClass(cls) : cls;
  Method method = class_getInstanceMethod(target, sel);
  const char *encoding = method ? method_getTypeEncoding(method) : types;
  if (method) {
    sOriginalIMPs[OrbitIMPKey(cls, sel, classMethod)] =
        [NSValue valueWithPointer:(void *)method_getImplementation(method)];
  }
  if (!class_addMethod(target, sel, replacement, encoding)) {
    // The class implements the selector itself: replace it in place.
    method_setImplementation(method, replacement);
  }
}

#define SWIZZLE_INSTANCE(cls, sel, fn, types) \
  OrbitSwizzle(cls, @selector(sel), (IMP)fn, types, NO)
#define SWIZZLE_CLASS(cls, sel, fn, types) \
  OrbitSwizzle(cls, @selector(sel), (IMP)fn, types, YES)

#pragma mark - Associated storage

static const void *kOrbitSessionStateKey = &kOrbitSessionStateKey;
static const void *kOrbitOutputStateKey = &kOrbitOutputStateKey;
static const void *kOrbitPreviewStateKey = &kOrbitPreviewStateKey;
static const void *kOrbitPickerStateKey = &kOrbitPickerStateKey;

#pragma mark - Time

static uint64_t OrbitHostNanos(void) {
  static mach_timebase_info_data_t timebase;
  if (timebase.denom == 0) mach_timebase_info(&timebase);
  return mach_absolute_time() * timebase.numer / timebase.denom;
}

#pragma mark - Shared memory reader

@interface OrbitFrameReader : NSObject
@property (nonatomic, readonly) AVCaptureDevicePosition position;
/// The frame of the newest sequence, or nil before the writer published one.
- (CVPixelBufferRef)copyCurrentFrame:(BOOL *)sourceMirrored;
@end

@implementation OrbitFrameReader {
  NSString *_path;
  int _fd;
  void *_map;
  size_t _mapSize;
  uint64_t _lastSequence;
  uint64_t _lastOpenAttemptNanos;
  CVPixelBufferRef _frame;
  BOOL _frameMirrored;
  NSLock *_lock;
}

- (instancetype)initWithPosition:(AVCaptureDevicePosition)position directory:(NSString *)dir {
  if ((self = [super init])) {
    _position = position;
    _path = [dir stringByAppendingPathComponent:position == AVCaptureDevicePositionFront
                                                     ? @"front.shm"
                                                     : @"back.shm"];
    _fd = -1;
    _lock = [NSLock new];
  }
  return self;
}

- (BOOL)mapIfNeeded {
  if (_map) return YES;
  // The writer creates the file when Orbit enables the camera. Retry at most twice a second.
  uint64_t now = OrbitHostNanos();
  if (now - _lastOpenAttemptNanos < 500000000ull) return NO;
  _lastOpenAttemptNanos = now;

  int fd = open(_path.fileSystemRepresentation, O_RDONLY);
  if (fd < 0) return NO;
  struct stat st;
  if (fstat(fd, &st) != 0 || (size_t)st.st_size < ORBIT_CAMERA_SHM_FILE_SIZE) {
    close(fd);
    return NO;
  }
  void *map = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd, 0);
  if (map == MAP_FAILED) {
    close(fd);
    return NO;
  }
  const OrbitCameraShmHeader *header = map;
  if (header->magic != ORBIT_CAMERA_SHM_MAGIC || header->version != ORBIT_CAMERA_SHM_VERSION ||
      header->headerSize != ORBIT_CAMERA_SHM_HEADER_SIZE ||
      header->slotCount != ORBIT_CAMERA_SHM_SLOT_COUNT ||
      header->slotSize != ORBIT_CAMERA_SHM_SLOT_SIZE) {
    ORBIT_LOG(@"Unsupported frame file %@", _path);
    munmap(map, (size_t)st.st_size);
    close(fd);
    return NO;
  }
  _fd = fd;
  _map = map;
  _mapSize = (size_t)st.st_size;
  _lastSequence = 0;
  ORBIT_LOG(@"Mapped %@", _path);
  return YES;
}

- (void)unmap {
  if (_map) munmap(_map, _mapSize);
  if (_fd >= 0) close(_fd);
  _map = NULL;
  _fd = -1;
  _lastSequence = 0;
}

static CVPixelBufferRef OrbitCreateBGRAPixelBuffer(size_t width, size_t height) {
  NSDictionary *attrs = @{
    (id)kCVPixelBufferIOSurfacePropertiesKey : @{},
    (id)kCVPixelBufferCGImageCompatibilityKey : @YES,
    (id)kCVPixelBufferCGBitmapContextCompatibilityKey : @YES,
  };
  CVPixelBufferRef buffer = NULL;
  CVPixelBufferCreate(kCFAllocatorDefault, width, height, kCVPixelFormatType_32BGRA,
                      (__bridge CFDictionaryRef)attrs, &buffer);
  return buffer;
}

- (CVPixelBufferRef)copyCurrentFrame:(BOOL *)sourceMirrored {
  [_lock lock];
  if ([self mapIfNeeded]) {
    const OrbitCameraShmHeader *header = _map;
    uint64_t now = OrbitHostNanos();
    BOOL alive = header->heartbeatNanos != 0 &&
                 now >= header->heartbeatNanos &&
                 now - header->heartbeatNanos < ORBIT_CAMERA_HEARTBEAT_TIMEOUT_NANOS;
    if (!alive) {
      // Orbit stopped writing: forget the stale frame so the placeholder shows. Unmap so a
      // file that Orbit recreates later is picked up.
      if (_frame) CVBufferRelease(_frame);
      _frame = NULL;
      [self unmap];
    } else if (header->sequence != _lastSequence && header->sequence != 0) {
      uint32_t width = header->width, height = header->height, bytesPerRow = header->bytesPerRow;
      uint32_t slot = header->frameSlot;
      if (width > 0 && height > 0 && width <= ORBIT_CAMERA_MAX_WIDTH &&
          height <= ORBIT_CAMERA_MAX_HEIGHT && bytesPerRow >= width * 4 &&
          (uint64_t)bytesPerRow * height <= ORBIT_CAMERA_SHM_SLOT_SIZE &&
          slot < ORBIT_CAMERA_SHM_SLOT_COUNT &&
          header->pixelFormat == kCVPixelFormatType_32BGRA) {
        CVPixelBufferRef buffer = NULL;
        if (_frame && CVPixelBufferGetWidth(_frame) == width &&
            CVPixelBufferGetHeight(_frame) == height && CFGetRetainCount(_frame) == 1) {
          // Nobody else holds the previous frame: reuse its memory.
          buffer = (CVPixelBufferRef)CFRetain(_frame);
        } else {
          buffer = OrbitCreateBGRAPixelBuffer(width, height);
        }
        if (buffer) {
          const uint8_t *src = (const uint8_t *)_map + ORBIT_CAMERA_SHM_HEADER_SIZE +
                               (size_t)slot * ORBIT_CAMERA_SHM_SLOT_SIZE;
          CVPixelBufferLockBaseAddress(buffer, 0);
          uint8_t *dst = CVPixelBufferGetBaseAddress(buffer);
          size_t dstBytesPerRow = CVPixelBufferGetBytesPerRow(buffer);
          if (dstBytesPerRow == bytesPerRow) {
            memcpy(dst, src, (size_t)bytesPerRow * height);
          } else {
            size_t rowBytes = MIN(dstBytesPerRow, (size_t)bytesPerRow);
            for (uint32_t y = 0; y < height; y++) {
              memcpy(dst + y * dstBytesPerRow, src + (size_t)y * bytesPerRow, rowBytes);
            }
          }
          CVPixelBufferUnlockBaseAddress(buffer, 0);
          if (_frame) CVBufferRelease(_frame);
          _frame = buffer;
          _frameMirrored = (header->flags & ORBIT_CAMERA_FLAG_SOURCE_MIRRORED) != 0;
          _lastSequence = header->sequence;
        }
      }
    }
  }
  CVPixelBufferRef result = _frame ? (CVPixelBufferRef)CFRetain(_frame) : NULL;
  if (sourceMirrored) *sourceMirrored = _frameMirrored;
  [_lock unlock];
  return result;
}

@end

#pragma mark - Placeholder frame

// Shown while Orbit has no source for a camera, so an app still gets frames and shows that
// the virtual camera is in place.
static CVPixelBufferRef OrbitCreatePlaceholderFrame(AVCaptureDevicePosition position) {
  size_t width = 1280, height = 720;
  CVPixelBufferRef buffer = OrbitCreateBGRAPixelBuffer(width, height);
  if (!buffer) return NULL;
  CVPixelBufferLockBaseAddress(buffer, 0);
  CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
  CGContextRef ctx = CGBitmapContextCreate(
      CVPixelBufferGetBaseAddress(buffer), width, height, 8, CVPixelBufferGetBytesPerRow(buffer),
      colorSpace, kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
  if (ctx) {
    CGContextSetRGBFillColor(ctx, 0.11, 0.12, 0.16, 1);
    CGContextFillRect(ctx, CGRectMake(0, 0, width, height));
    // A ring of blocks that reads as a test pattern, so motion and orientation are visible.
    CGFloat colors[6][3] = {{0.96, 0.33, 0.33}, {0.98, 0.70, 0.22}, {0.35, 0.80, 0.45},
                            {0.30, 0.65, 0.98}, {0.60, 0.45, 0.95}, {0.95, 0.45, 0.75}};
    for (int i = 0; i < 6; i++) {
      CGContextSetRGBFillColor(ctx, colors[i][0], colors[i][1], colors[i][2], 1);
      CGContextFillRect(ctx, CGRectMake(80 + i * 190, 80, 160, 90));
    }
    UIGraphicsPushContext(ctx);
    // CoreGraphics draws with the origin at the bottom; flip for UIKit text drawing.
    CGContextTranslateCTM(ctx, 0, height);
    CGContextScaleCTM(ctx, 1, -1);
    NSDictionary *title = @{
      NSFontAttributeName : [UIFont boldSystemFontOfSize:44],
      NSForegroundColorAttributeName : [UIColor whiteColor],
    };
    NSDictionary *body = @{
      NSFontAttributeName : [UIFont systemFontOfSize:28],
      NSForegroundColorAttributeName : [UIColor colorWithWhite:0.85 alpha:1],
    };
    [@"Expo Orbit · Simulator Camera" drawAtPoint:CGPointMake(80, 260) withAttributes:title];
    NSString *which = position == AVCaptureDevicePositionFront ? @"front" : @"back";
    [[NSString stringWithFormat:@"No source for the %@ camera. Pick one in Orbit → Settings → Simulator Camera.", which]
        drawAtPoint:CGPointMake(80, 330)
        withAttributes:body];
    UIGraphicsPopContext();
    CGContextRelease(ctx);
  }
  CGColorSpaceRelease(colorSpace);
  CVPixelBufferUnlockBaseAddress(buffer, 0);
  return buffer;
}

#pragma mark - Frame orientation

// Rotates and mirrors a frame for a connection. Sources are landscape ("sensor" orientation,
// like the frames of a real camera); `angle` is the AVCaptureConnection videoRotationAngle.
static CVPixelBufferRef OrbitCreateOrientedFrame(CVPixelBufferRef source, CGFloat angle, BOOL mirror) {
  if (!source) return NULL;
  int quarterTurns = ((int)lround(angle / 90)) % 4;
  if (quarterTurns < 0) quarterTurns += 4;
  if (quarterTurns == 0 && !mirror) return (CVPixelBufferRef)CFRetain(source);

  size_t srcWidth = CVPixelBufferGetWidth(source), srcHeight = CVPixelBufferGetHeight(source);
  BOOL swap = quarterTurns % 2 == 1;
  size_t dstWidth = swap ? srcHeight : srcWidth, dstHeight = swap ? srcWidth : srcHeight;
  CVPixelBufferRef dst = OrbitCreateBGRAPixelBuffer(dstWidth, dstHeight);
  if (!dst) return NULL;

  CVPixelBufferLockBaseAddress(source, kCVPixelBufferLock_ReadOnly);
  CVPixelBufferLockBaseAddress(dst, 0);
  CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
  CGBitmapInfo info = kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little;
  CGContextRef srcCtx = CGBitmapContextCreate(CVPixelBufferGetBaseAddress(source), srcWidth, srcHeight,
                                              8, CVPixelBufferGetBytesPerRow(source), colorSpace, info);
  CGImageRef image = srcCtx ? CGBitmapContextCreateImage(srcCtx) : NULL;
  CGContextRef dstCtx = CGBitmapContextCreate(CVPixelBufferGetBaseAddress(dst), dstWidth, dstHeight, 8,
                                              CVPixelBufferGetBytesPerRow(dst), colorSpace, info);
  if (image && dstCtx) {
    CGContextSetInterpolationQuality(dstCtx, kCGInterpolationLow);
    CGContextTranslateCTM(dstCtx, dstWidth / 2.0, dstHeight / 2.0);
    if (mirror) CGContextScaleCTM(dstCtx, -1, 1);
    // CoreGraphics' y axis points up, so a clockwise image rotation is a negative angle.
    CGContextRotateCTM(dstCtx, -quarterTurns * M_PI_2);
    CGContextDrawImage(dstCtx, CGRectMake(-(CGFloat)srcWidth / 2, -(CGFloat)srcHeight / 2, srcWidth, srcHeight), image);
  }
  if (dstCtx) CGContextRelease(dstCtx);
  if (image) CGImageRelease(image);
  if (srcCtx) CGContextRelease(srcCtx);
  CGColorSpaceRelease(colorSpace);
  CVPixelBufferUnlockBaseAddress(dst, 0);
  CVPixelBufferUnlockBaseAddress(source, kCVPixelBufferLock_ReadOnly);
  return dst;
}

static CMSampleBufferRef OrbitCreateSampleBuffer(CVPixelBufferRef pixelBuffer, CMTime pts) {
  if (!pixelBuffer) return NULL;
  CMVideoFormatDescriptionRef format = NULL;
  if (CMVideoFormatDescriptionCreateForImageBuffer(kCFAllocatorDefault, pixelBuffer, &format) != noErr) {
    return NULL;
  }
  CMSampleTimingInfo timing = {
    .duration = CMTimeMake(1, kOrbitFrameRate), .presentationTimeStamp = pts, .decodeTimeStamp = kCMTimeInvalid,
  };
  CMSampleBufferRef sample = NULL;
  CMSampleBufferCreateReadyWithImageBuffer(kCFAllocatorDefault, pixelBuffer, format, &timing, &sample);
  CFRelease(format);
  return sample;
}

static CGImageRef OrbitCreateCGImage(CVPixelBufferRef pixelBuffer) {
  if (!pixelBuffer) return NULL;
  CVPixelBufferLockBaseAddress(pixelBuffer, kCVPixelBufferLock_ReadOnly);
  CGColorSpaceRef colorSpace = CGColorSpaceCreateDeviceRGB();
  CGContextRef ctx = CGBitmapContextCreate(
      CVPixelBufferGetBaseAddress(pixelBuffer), CVPixelBufferGetWidth(pixelBuffer),
      CVPixelBufferGetHeight(pixelBuffer), 8, CVPixelBufferGetBytesPerRow(pixelBuffer), colorSpace,
      kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
  CGImageRef image = ctx ? CGBitmapContextCreateImage(ctx) : NULL;
  if (ctx) CGContextRelease(ctx);
  CGColorSpaceRelease(colorSpace);
  CVPixelBufferUnlockBaseAddress(pixelBuffer, kCVPixelBufferLock_ReadOnly);
  return image;
}

#pragma mark - Frame rate range and format

@interface OrbitFrameRateRange : AVFrameRateRange
@end
@implementation OrbitFrameRateRange
- (instancetype)init { return self; }  // AVFrameRateRange has no public initializer.
- (Float64)minFrameRate { return 1; }
- (Float64)maxFrameRate { return kOrbitFrameRate; }
- (CMTime)minFrameDuration { return CMTimeMake(1, kOrbitFrameRate); }
- (CMTime)maxFrameDuration { return CMTimeMake(1, 1); }
- (NSString *)description { return @"<OrbitFrameRateRange 1-30 fps>"; }
@end

@interface OrbitDeviceFormat : AVCaptureDeviceFormat
@property (nonatomic) int32_t width;
@property (nonatomic) int32_t height;
@end
@implementation OrbitDeviceFormat {
  CMVideoFormatDescriptionRef _description;
}
+ (instancetype)formatWithWidth:(int32_t)width height:(int32_t)height {
  OrbitDeviceFormat *format = [self alloc];
  format.width = width;
  format.height = height;
  CMVideoFormatDescriptionCreate(kCFAllocatorDefault, kCVPixelFormatType_32BGRA, width, height, NULL,
                                 &format->_description);
  return format;
}
- (instancetype)init { return self; }
- (void)dealloc {
  if (_description) CFRelease(_description);
}
- (NSString *)mediaType { return AVMediaTypeVideo; }
- (CMFormatDescriptionRef)formatDescription { return _description; }
- (NSArray<AVFrameRateRange *> *)videoSupportedFrameRateRanges { return @[ [OrbitFrameRateRange alloc] ]; }
- (float)videoFieldOfView { return 60; }
- (BOOL)isVideoBinned { return NO; }
- (BOOL)isVideoStabilizationModeSupported:(AVCaptureVideoStabilizationMode)mode { return mode == AVCaptureVideoStabilizationModeOff; }
- (CGFloat)videoMaxZoomFactor { return 1; }
- (CGFloat)videoZoomFactorUpscaleThreshold { return 1; }
- (CMTime)minExposureDuration { return CMTimeMake(1, 1000); }
- (CMTime)maxExposureDuration { return CMTimeMake(1, 30); }
- (float)minISO { return 50; }
- (float)maxISO { return 1600; }
- (BOOL)isVideoHDRSupported { return NO; }
- (CMVideoDimensions)highResolutionStillImageDimensions { return (CMVideoDimensions){ _width, _height }; }
- (NSArray<NSValue *> *)supportedMaxPhotoDimensions { return @[ [NSValue valueWithBytes:&(CMVideoDimensions){ _width, _height } objCType:@encode(CMVideoDimensions)] ]; }
- (NSArray<AVCaptureDeviceFormat *> *)supportedDepthDataFormats { return @[]; }
- (NSArray *)unsupportedCaptureOutputClasses { return @[]; }
- (BOOL)isMultiCamSupported { return NO; }
- (BOOL)isHighestPhotoQualitySupported { return YES; }
- (BOOL)isHighPhotoQualitySupported { return YES; }
- (BOOL)isPortraitEffectSupported { return NO; }
- (BOOL)isCenterStageSupported { return NO; }
- (BOOL)isGlobalToneMappingSupported { return NO; }
- (BOOL)isAutoVideoFrameRateSupported { return NO; }
- (BOOL)isVideoFrameRateRangeForCenterStageSupported { return NO; }
- (NSArray<NSNumber *> *)supportedColorSpaces { return @[ @(AVCaptureColorSpace_sRGB) ]; }
- (BOOL)isReactionEffectsSupported { return NO; }
- (BOOL)isStudioLightSupported { return NO; }
- (BOOL)isBackgroundReplacementSupported { return NO; }
- (NSArray<NSNumber *> *)secondaryNativeResolutionZoomFactors { return @[]; }
- (NSArray<NSNumber *> *)supportedVideoZoomFactorsForDepthDataDelivery { return @[]; }
// AVFoundation's own code (for example AVCapturePhotoSettings) reaches the engine object
// of a format through these private accessors; the virtual format has none.
- (id)figCaptureSourceVideoFormat { return nil; }
- (id)figCaptureSourceDepthDataFormat { return nil; }
- (NSString *)description {
  return [NSString stringWithFormat:@"<OrbitDeviceFormat %dx%d BGRA>", _width, _height];
}
@end

#pragma mark - Device

@interface OrbitCaptureDevice : AVCaptureDevice
@property (nonatomic, readonly) AVCaptureDevicePosition orbitPosition;
@property (nonatomic, readonly) NSString *orbitUniqueID;
+ (instancetype)frontDevice;
+ (instancetype)backDevice;
+ (NSArray<OrbitCaptureDevice *> *)allDevices;
+ (OrbitCaptureDevice *)deviceForPosition:(AVCaptureDevicePosition)position;
@end

@implementation OrbitCaptureDevice {
  NSArray *_formats;
  OrbitDeviceFormat *_activeFormat;
  AVCaptureFocusMode _focusMode;
  AVCaptureExposureMode _exposureMode;
  AVCaptureWhiteBalanceMode _whiteBalanceMode;
  CGPoint _focusPoint, _exposurePoint;
  CGFloat _zoom;
  float _exposureBias;
  BOOL _subjectAreaMonitoring;
  CMTime _minFrameDuration, _maxFrameDuration;
}

static OrbitCaptureDevice *sFrontDevice, *sBackDevice;

+ (instancetype)deviceWithPosition:(AVCaptureDevicePosition)position uniqueID:(NSString *)uniqueID {
  // AVCaptureDevice cannot be initialized on a simulator; the instance is allocated and the
  // state it needs lives in this subclass.
  OrbitCaptureDevice *device = [self alloc];
  device->_orbitPosition = position;
  device->_orbitUniqueID = uniqueID;
  device->_formats = @[
    [OrbitDeviceFormat formatWithWidth:1920 height:1080],
    [OrbitDeviceFormat formatWithWidth:1280 height:720],
    [OrbitDeviceFormat formatWithWidth:640 height:480],
  ];
  device->_activeFormat = device->_formats[0];
  device->_focusMode = AVCaptureFocusModeContinuousAutoFocus;
  device->_exposureMode = AVCaptureExposureModeContinuousAutoExposure;
  device->_whiteBalanceMode = AVCaptureWhiteBalanceModeContinuousAutoWhiteBalance;
  device->_focusPoint = CGPointMake(0.5, 0.5);
  device->_exposurePoint = CGPointMake(0.5, 0.5);
  device->_zoom = 1;
  device->_minFrameDuration = CMTimeMake(1, kOrbitFrameRate);
  device->_maxFrameDuration = CMTimeMake(1, kOrbitFrameRate);
  return device;
}
+ (instancetype)frontDevice {
  static dispatch_once_t once;
  dispatch_once(&once, ^{
    sFrontDevice = [self deviceWithPosition:AVCaptureDevicePositionFront uniqueID:kOrbitFrontDeviceID];
  });
  return sFrontDevice;
}
+ (instancetype)backDevice {
  static dispatch_once_t once;
  dispatch_once(&once, ^{
    sBackDevice = [self deviceWithPosition:AVCaptureDevicePositionBack uniqueID:kOrbitBackDeviceID];
  });
  return sBackDevice;
}
+ (NSArray<OrbitCaptureDevice *> *)allDevices { return @[ [self backDevice], [self frontDevice] ]; }
+ (OrbitCaptureDevice *)deviceForPosition:(AVCaptureDevicePosition)position {
  return position == AVCaptureDevicePositionFront ? [self frontDevice] : [self backDevice];
}

- (instancetype)init { return self; }
- (NSString *)uniqueID { return _orbitUniqueID; }
- (NSString *)modelID { return @"Orbit Virtual Camera"; }
- (NSString *)localizedName {
  return _orbitPosition == AVCaptureDevicePositionFront ? @"Front Camera" : @"Back Camera";
}
- (NSString *)manufacturer { return @"Expo"; }
- (AVCaptureDeviceType)deviceType { return AVCaptureDeviceTypeBuiltInWideAngleCamera; }
- (AVCaptureDevicePosition)position { return _orbitPosition; }
- (BOOL)hasMediaType:(AVMediaType)mediaType { return [mediaType isEqualToString:AVMediaTypeVideo]; }
- (BOOL)supportsAVCaptureSessionPreset:(AVCaptureSessionPreset)preset { return YES; }
- (BOOL)isConnected { return YES; }
- (BOOL)isSuspended { return NO; }
- (BOOL)isInUseByAnotherApplication { return NO; }
- (BOOL)isVirtualDevice { return NO; }
- (NSArray<AVCaptureDevice *> *)constituentDevices { return @[]; }
- (BOOL)isContinuityCamera { return NO; }
- (BOOL)lockForConfiguration:(NSError **)error { return YES; }
- (void)unlockForConfiguration {}
- (NSArray<AVCaptureDeviceFormat *> *)formats { return _formats; }
- (AVCaptureDeviceFormat *)activeFormat { return _activeFormat; }
- (void)setActiveFormat:(AVCaptureDeviceFormat *)format {
  if ([format isKindOfClass:[OrbitDeviceFormat class]]) _activeFormat = (OrbitDeviceFormat *)format;
}
- (CMTime)activeVideoMinFrameDuration { return _minFrameDuration; }
- (void)setActiveVideoMinFrameDuration:(CMTime)d { _minFrameDuration = d; }
- (CMTime)activeVideoMaxFrameDuration { return _maxFrameDuration; }
- (void)setActiveVideoMaxFrameDuration:(CMTime)d { _maxFrameDuration = d; }
- (AVCaptureDeviceFormat *)activeDepthDataFormat { return nil; }
- (void)setActiveDepthDataFormat:(AVCaptureDeviceFormat *)f {}
- (AVCaptureColorSpace)activeColorSpace { return AVCaptureColorSpace_sRGB; }
- (void)setActiveColorSpace:(AVCaptureColorSpace)s {}

// Flash and torch
- (BOOL)hasFlash { return NO; }
- (BOOL)isFlashAvailable { return NO; }
- (BOOL)isFlashActive { return NO; }
