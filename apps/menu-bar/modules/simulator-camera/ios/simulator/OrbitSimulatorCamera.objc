@interface OrbitMetadataObject : AVMetadataMachineReadableCodeObject
@property (nonatomic, copy) NSString *orbitType;
@property (nonatomic, copy) NSString *orbitValue;
@property (nonatomic) CGRect orbitBounds;
@property (nonatomic, copy) NSArray *orbitCorners;
@property (nonatomic) CMTime orbitTime;
@end
@implementation OrbitMetadataObject
- (instancetype)init { return self; }
- (AVMetadataObjectType)type { return _orbitType; }
- (NSString *)stringValue { return _orbitValue; }
- (CGRect)bounds { return _orbitBounds; }
- (NSArray *)corners { return _orbitCorners; }
- (CMTime)time { return _orbitTime; }
- (CMTime)duration { return kCMTimeInvalid; }
- (id)descriptor { return nil; }
- (NSString *)description {
  return [NSString stringWithFormat:@"<OrbitMetadataObject %@ %@ %@>", _orbitType, _orbitValue, NSStringFromCGRect(_orbitBounds)];
}
@end

// Normalized point in a rotated frame → normalized point in the unrotated (sensor) frame.
static NSArray<OrbitMetadataObject *> *OrbitDetectCodes(CVPixelBufferRef frame, CGFloat angle, BOOL mirrored) {
  static CIDetector *detector;
  static CIContext *context;
  static dispatch_once_t once;
  dispatch_once(&once, ^{
    context = [CIContext contextWithOptions:@{ kCIContextUseSoftwareRenderer : @YES }];
    detector = [CIDetector detectorOfType:CIDetectorTypeQRCode context:context options:@{ CIDetectorAccuracy : CIDetectorAccuracyHigh }];
  });
  if (!frame || !detector) return @[];
  CIImage *image = [CIImage imageWithCVPixelBuffer:frame];
  CGFloat width = CVPixelBufferGetWidth(frame), height = CVPixelBufferGetHeight(frame);
  NSMutableArray *objects = [NSMutableArray new];
  CMTime now = CMClockGetTime(CMClockGetHostTimeClock());
  for (CIFeature *feature in [detector featuresInImage:image]) {
    if (![feature isKindOfClass:[CIQRCodeFeature class]]) continue;
    CIQRCodeFeature *qr = (CIQRCodeFeature *)feature;
    if (!qr.messageString) continue;
    // CoreImage's origin is bottom-left; AVFoundation's bounds are normalized, top-left.
    CGRect b = qr.bounds;
    CGRect bounds = CGRectMake(b.origin.x / width, 1 - (b.origin.y + b.size.height) / height,
                               b.size.width / width, b.size.height / height);
    OrbitMetadataObject *object = [OrbitMetadataObject alloc];
    object.orbitType = AVMetadataObjectTypeQRCode;
    object.orbitValue = qr.messageString;
    object.orbitBounds = bounds;
    object.orbitTime = now;
    CGPoint corners[4] = { qr.topLeft, qr.topRight, qr.bottomRight, qr.bottomLeft };
    NSMutableArray *points = [NSMutableArray new];
    for (int i = 0; i < 4; i++) {
      [points addObject:@{ @"X" : @(corners[i].x / width), @"Y" : @(1 - corners[i].y / height) }];
    }
    object.orbitCorners = points;
    [objects addObject:object];
  }
  return objects;
}

