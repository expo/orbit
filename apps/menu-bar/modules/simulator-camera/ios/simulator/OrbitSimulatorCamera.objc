static BOOL OrbitShouldLoad(void) {
  if (getenv("ORBIT_SIMULATOR_CAMERA_FORCE")) return YES;
  // Only UIKit apps, and not Apple's own, which have no use for a camera shim and may be
  // sensitive to swizzling.
  const char *service = getenv("XPC_SERVICE_NAME");
  if (!service || strncmp(service, "UIKitApplication:", 17) != 0) return NO;
  if (strncmp(service + 17, "com.apple.", 10) == 0) return NO;
  return YES;
}

__attribute__((constructor)) static void OrbitSimulatorCameraLoad(void) {
  if (!OrbitShouldLoad()) return;
  @autoreleasepool {
    sVerbose = getenv("ORBIT_SIMULATOR_CAMERA_LOG") != NULL;
    const char *dir = getenv("ORBIT_SIMULATOR_CAMERA_DIR");
    sFramesDirectory = dir ? @(dir) : [NSString stringWithFormat:@ORBIT_CAMERA_DEFAULT_DIR_FORMAT, getuid()];
    sOriginalIMPs = [NSMutableDictionary new];
    sSessions = [NSHashTable weakObjectsHashTable];
    sSessionsLock = [NSLock new];
    sFrontReader = [[OrbitFrameReader alloc] initWithPosition:AVCaptureDevicePositionFront directory:sFramesDirectory];
    sBackReader = [[OrbitFrameReader alloc] initWithPosition:AVCaptureDevicePositionBack directory:sFramesDirectory];
    OrbitInstallSwizzles();
    OrbitStartFrameTimer();
    NSLog(@"[OrbitSimulatorCamera] Virtual camera installed (frames in %@)", sFramesDirectory);
  }
}
